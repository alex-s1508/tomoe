#!/usr/bin/env bash
set -Eeuo pipefail

# ---------------------------------------------------------------------------
# Tomoe installer
# ---------------------------------------------------------------------------
# Install and configure Umbriel + Noctalia + Noctalia Greeter on CachyOS/Arch.
# Usage: ./tomoe install [--dry-run] [--yes] [--reboot]
# ---------------------------------------------------------------------------

umask 077
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
dotfiles="$repo_root/dotfiles"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/tomoe"
backup_dir=""
log_file=""
dry_run=false
assume_yes=false
reboot_after=false
sudo_keepalive_pid=""

TOTAL_STEPS=11
STEP=0

if [[ -t 1 ]]; then
    C_RESET=$'\033[0m'
    C_DIM=$'\033[2m'
    C_GREEN=$'\033[38;5;114m'
    C_RED=$'\033[38;5;203m'
    C_YELLOW=$'\033[38;5;179m'
else
    C_RESET=""
    C_DIM=""
    C_GREEN=""
    C_RED=""
    C_YELLOW=""
fi

# ---------------------------------------------------------------------------
# Messages
# ---------------------------------------------------------------------------
msg_sudo="Administrator permission is required. Enter your password once."
msg_confirm="Install the T O M O E 巴 dotfiles now? [y/N] "
msg_cancelled="Installation cancelled."
msg_dry_run="Dry-run mode: no changes will be made to the system."
msg_dry_done="Dry run complete. No changes were made."
msg_error_line="error at line"
msg_dry_reboot="Dry-run: reboot will not be executed."
msg_step_preflight="Checking system and dotfiles"
msg_step_remove="Removing replaced CachyOS packages"
msg_step_pacman="Installing packages from the official repositories"
msg_step_aur="Installing AUR packages"
msg_step_validate_repo="Validating the modular Umbriel configuration"
msg_step_umbriel="Copying the Umbriel configuration"
msg_step_desktop="Applying Chrome, desktop entries and wallpapers"
msg_step_noctalia="Configuring Noctalia and wallpapers"
msg_step_greetd="Configuring greetd and Noctalia Greeter"
msg_step_validate="Validating the installed configuration"
msg_step_restart="Enabling and restarting greetd"
msg_done="Tomoe installed successfully."
msg_log="Log:"
msg_backups="Backups:"
msg_reboot="Restart the computer now? [y/N] "
msg_reboot_skip="Reboot postponed. Restart manually when ready."
msg_reboot_yes="Restarting the computer..."
msg_need_tty="The installer needs an interactive terminal. Use --yes to install without confirmation."
msg_run_as_user="Run the installer as your normal user, not as root."
msg_missing="Required file not found:"
msg_missing_cmd="Required command not found:"
msg_invalid_config="The Umbriel configuration is invalid. Fix the files and try again."
msg_umbriel_missing="Umbriel was not found after installation."
msg_greetd_deferred="The current session is managed by greetd; the restart was postponed to the next boot."
msg_install_failed="Failed to install"
msg_remove_failed="Some packages could not be removed; continuing with the rest."
msg_yay_missing="yay was not found; cannot install AUR packages."
msg_backup_failed="Failed to back up"
msg_keep_pkg="keeping %s: required by %s"
msg_reference_missing="reference /usr/share/umbriel/config.toml not found"
msg_greetd_enable_failed="could not enable greetd"
msg_greetd_restart_failed="could not restart greetd"
msg_greeter_group_failed="could not add greeter to the video group"
msg_log_tail="Last log lines:"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
usage() {
    cat <<'USAGE'
Usage:
  ./tomoe install [--dry-run] [--yes] [--reboot]
  ./tomoe update [--dry-run] [--yes] [--all|--umbriel|--noctalia|--fastfetch|--chrome|--greetd|--monitors]
  ./tomoe hidden-apps [--list|--show|--hide]

  --dry-run   Show every action without changing the system.
  --yes, -y   Skip the installation confirmation (useful for automation).
  --reboot    Reboot automatically when the installation finishes.
  --list      List hidden apps.
  --show      Show hidden apps again.
  --hide      Hide apps (default).

Package lists live in dotfiles/packages/:
  repo.txt      official repository packages
  aur.txt       AUR packages installed with yay
  remove.txt    CachyOS packages removed when safe
USAGE
}

log() {
    [[ -n "$log_file" ]] || return 0
    printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" >>"$log_file"
}

warn() {
    printf '\n%s  ! %s%s\n' "$C_YELLOW" "$*" "$C_RESET" >&2
    log "WARN: $*"
}

die() {
    printf '\n%s  ✗ %s%s\n' "$C_RED" "$*" "$C_RESET" >&2
    log "ERROR: $*"
    show_log_tail
    exit 1
}

show_log_tail() {
    if [[ -n "${log_file:-}" && -f "$log_file" ]]; then
        printf '%s%s%s\n' "$C_DIM" "$msg_log_tail" "$C_RESET" >&2
        tail -n 30 "$log_file" >&2 || true
    fi
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "$msg_missing_cmd $1"
}

setup_logging() {
    if [[ "$dry_run" == true ]]; then
        log_file="$(mktemp "${TMPDIR:-/tmp}/tomoe-dry-run.XXXXXX.log")"
        backup_dir=""
    else
        if [[ -e "$state_dir" && ( ! -O "$state_dir" || ! -w "$state_dir" ) ]]; then
            sudo chown -R "$(id -u):$(id -g)" "$state_dir" 2>/dev/null || true
        fi
        mkdir -p "$state_dir"
        if [[ -e "$state_dir/backups" && ( ! -O "$state_dir/backups" || ! -w "$state_dir/backups" ) ]]; then
            sudo chown -R "$(id -u):$(id -g)" "$state_dir/backups" 2>/dev/null || true
        fi
        mkdir -p "$state_dir/backups"
        chown "$(id -u):$(id -g)" "$state_dir/backups" 2>/dev/null || true
        log_file="$state_dir/install-$(date +%Y%m%d-%H%M%S).log"
        : >"$log_file"
        backup_dir="$state_dir/backups/$(date +%Y%m%d-%H%M%S)"
    fi
}

show_header() {
    local header="$dotfiles/assets/ascii/installer.txt"
    if [[ -r "$header" ]]; then
        grep -v '^#' "$header" || true
    else
        printf 'T O M O E 巴\n'
    fi
}

ask_install() {
    if [[ "$assume_yes" == true ]]; then
        return 0
    fi
    if [[ ! -t 0 ]]; then
        die "$msg_need_tty"
    fi
    local answer=""
    read -r -p "$msg_confirm" answer || answer=""
    case "$answer" in
        y|Y|yes|YES|Yes) return 0 ;;
        *) printf '%s\n' "$msg_cancelled"; exit 0 ;;
    esac
}

start_sudo() {
    if [[ "$dry_run" == true ]]; then
        return 0
    fi
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
        die "$msg_run_as_user"
    fi
    printf '%s\n' "$msg_sudo"
    sudo -v || die "sudo: authentication failed"
    (
        while kill -0 "$$" 2>/dev/null; do
            sudo -n true 2>/dev/null || exit 0
            sleep 50
        done
    ) &
    sudo_keepalive_pid=$!
    log "sudo keepalive started (pid $sudo_keepalive_pid)"
}

stop_sudo() {
    if [[ -n "$sudo_keepalive_pid" ]]; then
        kill "$sudo_keepalive_pid" 2>/dev/null || true
        wait "$sudo_keepalive_pid" 2>/dev/null || true
        sudo_keepalive_pid=""
    fi
}

cleanup() {
    stop_sudo
}

trap cleanup EXIT

on_error() {
    local rc=$?
    printf '\n%s  ✗ %s %s (exit %s)%s\n' "$C_RED" "$msg_error_line" "$1" "$rc" "$C_RESET" >&2
    show_log_tail
    exit "$rc"
}
trap 'on_error $LINENO' ERR

step_begin() {
    STEP=$((STEP + 1))
    CURRENT_STEP="$1"
    printf '  [%d/%d] %s ' "$STEP" "$TOTAL_STEPS" "$CURRENT_STEP"
}

step_done() {
    printf '%s✓%s\n' "$C_GREEN" "$C_RESET"
}

run_logged() {
    if [[ "$dry_run" == true ]]; then
        log "[dry-run] $*"
        printf '  %s(dry-run)%s %s\n' "$C_DIM" "$C_RESET" "$*"
        return 0
    fi
    log "\$ $*"
    "$@" >>"$log_file" 2>&1 &
    local pid=$!
    local rc=0
    while kill -0 "$pid" 2>/dev/null; do
        sleep 0.12
    done
    if wait "$pid"; then
        rc=0
    else
        rc=$?
    fi
    if [[ "$rc" -ne 0 ]]; then
        printf '\n%s  ✗ %s (exit %d); see %s%s\n' "$C_RED" "$*" "$rc" "$log_file" "$C_RESET" >&2
    fi
    return "$rc"
}

run_quiet() {
    if [[ "$dry_run" == true ]]; then
        log "[dry-run] $*"
        printf '  (dry-run) %s\n' "$*"
        return 0
    fi
    log "\$ $*"
    if "$@" >>"$log_file" 2>&1; then
        log "completed: $*"
        return 0
    else
        local rc=$?
        log "ERROR rc=$rc: $*"
        printf '\n%s  ✗ %s (exit %d); see %s%s\n' "$C_RED" "$*" "$rc" "$log_file" "$C_RESET" >&2
        return "$rc"
    fi
}

read_list() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$file" | grep -v '^$' || true
}

backup_path() {
    local src="$1" rel dest
    [[ -e "$src" || -L "$src" ]] || return 0
    if [[ "$dry_run" == true ]]; then
        log "[dry-run] backup $src"
        return 0
    fi
    if [[ "$src" == "$HOME"/* ]]; then
        rel="home/${src#"$HOME"/}"
    else
        rel="root${src}"
    fi
    dest="$backup_dir/$rel"
    if [[ -e "$dest" || -L "$dest" ]]; then
        return 0
    fi
    local backup_base="$state_dir/backups"
    if [[ -e "$backup_base" && ( ! -O "$backup_base" || ! -w "$backup_base" ) ]]; then
        sudo chown -R "$(id -u):$(id -g)" "$backup_base" 2>/dev/null || true
    fi
    mkdir -p "$(dirname "$dest")"
    cp -a -- "$src" "$dest" || die "$msg_backup_failed $src"
    log "backup: $src -> $dest"
}

backup_system_path() {
    local src="$1" dest="$backup_dir/system$1"
    [[ -e "$src" || -L "$src" ]] || return 0
    if [[ -e "$dest" || -L "$dest" ]]; then
        return 0
    fi
    if [[ "$dry_run" == true ]]; then
        log "[dry-run] backup $src -> $dest"
        return 0
    fi
    sudo mkdir -p "$(dirname "$dest")"
    sudo cp -a -- "$src" "$dest" || die "$msg_backup_failed $src"
    sudo chown -R "$(id -u):$(id -g)" "$state_dir/backups" 2>/dev/null || true
    log "backup: $src -> $dest"
}

install_file() {
    local src="$1" dest="$2" mode="${3:-644}"
    if [[ "$dry_run" == true ]]; then
        log "[dry-run] install $src -> $dest"
        printf '  %s(dry-run)%s %s -> %s\n' "$C_DIM" "$C_RESET" "$src" "$dest"
        return 0
    fi
    backup_path "$dest"
    mkdir -p "$(dirname "$dest")"
    if [[ -L "$dest" ]]; then
        rm -f -- "$dest"
    fi
    install -Dm"$mode" -- "$src" "$dest" || die "$msg_install_failed $dest"
    log "installed: $dest"
}

# ---------------------------------------------------------------------------
# Steps
# ---------------------------------------------------------------------------
validate_config() {
    local target="$1"
    if [[ "$dry_run" == true ]]; then
        umbriel config validate -c "$target" || die "$msg_invalid_config"
    else
        run_logged umbriel config validate -c "$target" || die "$msg_invalid_config"
    fi
}

preflight() {
    [[ -d "$dotfiles" ]] || die "$msg_missing $dotfiles"
    local required=(
        "$dotfiles/assets/ascii/installer.txt"
        "$dotfiles/config/umbriel/config.toml"
        "$dotfiles/config/greetd/config.toml"
        "$dotfiles/config/noctalia/settings.toml"
        "$dotfiles/packages/repo.txt"
        "$dotfiles/packages/aur.txt"
        "$dotfiles/packages/remove.txt"
    )
    local file
    for file in "${required[@]}"; do
        [[ -f "$file" ]] || die "$msg_missing $file"
    done
    require_cmd sudo
    require_cmd pacman
    require_cmd systemctl
    require_cmd loginctl
    require_cmd install
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
        die "$msg_run_as_user"
    fi
    if command -v umbriel >/dev/null 2>&1; then
        validate_config "$dotfiles/config/umbriel/config.toml"
    fi
}

array_contains() {
    local needle="$1"
    shift
    local item
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

remove_packages() {
    local -a list=() candidates=() next=()
    mapfile -t list < <(read_list "$dotfiles/packages/remove.txt")
    (( ${#list[@]} )) || return 0
    local pkg required_by dep
    for pkg in "${list[@]}"; do
        pacman -Qq "$pkg" >/dev/null 2>&1 && candidates+=("$pkg")
    done
    (( ${#candidates[@]} )) || return 0

    while true; do
        next=()
        for pkg in "${candidates[@]}"; do
            required_by="$(LC_ALL=C pacman -Qi "$pkg" 2>/dev/null | awk -F': ' '/^Required By/{print $2; exit}')"
            local safe=true
            if [[ -n "$required_by" && "$required_by" != "None" ]]; then
                for dep in $required_by; do
                    if ! array_contains "$dep" "${candidates[@]}"; then
                        safe=false
                        break
                    fi
                done
            fi
            if [[ "$safe" == true ]]; then
                next+=("$pkg")
            else
                warn "$(printf "$msg_keep_pkg" "$pkg" "$required_by")"
            fi
        done
        if (( ${#next[@]} == ${#candidates[@]} )); then
            break
        fi
        candidates=("${next[@]}")
        (( ${#candidates[@]} )) || return 0
    done

    run_logged sudo pacman -Rns --noconfirm "${candidates[@]}" \
        || warn "$msg_remove_failed"
}


valid_package_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]]
}

install_pacman_packages() {
    local -a pkgs=()
    mapfile -t pkgs < <(read_list "$dotfiles/packages/repo.txt")
    local -a clean=()
    local pkg
    for pkg in "${pkgs[@]}"; do
        if valid_package_name "$pkg"; then
            clean+=("$pkg")
        else
            warn "invalid package name ignored: $pkg"
        fi
    done
    pkgs=("${clean[@]}")
    if printf '%s\n' "${pkgs[@]}" | grep -Fxq -- yay \
        && ! pacman -Qq yay >/dev/null 2>&1; then
        run_logged sudo pacman -S --needed --noconfirm yay \
            || die "$msg_install_failed yay"
    fi
    for pkg in "${pkgs[@]}"; do
        if pacman -Qq "$pkg" >/dev/null 2>&1; then
            log "$pkg already installed"
            continue
        fi
        run_logged sudo pacman -S --needed --noconfirm "$pkg" \
            || die "$msg_install_failed $pkg"
    done
}

install_aur_packages() {
    local list="$1"
    local -a pkgs=()
    mapfile -t pkgs < <(read_list "$list")
    local -a clean=()
    local pkg
    for pkg in "${pkgs[@]}"; do
        if valid_package_name "$pkg"; then
            clean+=("$pkg")
        else
            warn "invalid package name ignored: $pkg"
        fi
    done
    pkgs=("${clean[@]}")
    (( ${#pkgs[@]} )) || return 0
    command -v yay >/dev/null 2>&1 || die "$msg_yay_missing"
    for pkg in "${pkgs[@]}"; do
        if pacman -Qq "$pkg" >/dev/null 2>&1; then
            log "$pkg already installed"
            continue
        fi
        run_logged yay -S --needed --noconfirm "$pkg" || return 1
    done
}

validate_repo_config() {
    command -v umbriel >/dev/null 2>&1 || die "$msg_umbriel_missing"
    validate_config "$dotfiles/config/umbriel/config.toml"
}

copy_umbriel() {
    local dest="$HOME/.config/umbriel"
    backup_path "$dest"
    if [[ -r /usr/share/umbriel/config.toml ]]; then
        install_file /usr/share/umbriel/config.toml "$dest/config.reference.toml"
    else
        warn "$msg_reference_missing"
    fi
    local file
    for file in "$dotfiles"/config/umbriel/*.toml; do
        install_file "$file" "$dest/$(basename "$file")"
    done
}

merge_chrome_flags() {
    local src="$dotfiles/config/chrome/flags.conf"
    local dest="$HOME/.config/chrome-flags.conf"
    local -a wanted=() missing=()
    mapfile -t wanted < <(read_list "$src")
    (( ${#wanted[@]} )) || return 0

    if [[ ! -f "$dest" ]]; then
        install_file "$src" "$dest"
        return 0
    fi

    local flag
    for flag in "${wanted[@]}"; do
        grep -Fxq -- "$flag" "$dest" || missing+=("$flag")
    done
    if (( ${#missing[@]} == 0 )); then
        log "chrome flags already present: $dest"
        return 0
    fi

    if [[ "$dry_run" == true ]]; then
        log "[dry-run] merge chrome flags -> $dest: ${missing[*]}"
        printf '  %s(dry-run)%s chrome flags -> %s\n' "$C_DIM" "$C_RESET" "$dest"
        return 0
    fi

    backup_path "$dest"
    if [[ -L "$dest" ]]; then
        rm -f -- "$dest"
    fi
    if [[ -s "$dest" && "$(tail -c 1 -- "$dest" | wc -l)" -eq 0 ]]; then
        printf '\n' >>"$dest"
    fi
    printf '%s\n' "${missing[@]}" >>"$dest"
    log "chrome flags merged: ${missing[*]}"
}

copy_desktop() {
    local src dest pictures_dir
    pictures_dir="$(xdg-user-dir PICTURES 2>/dev/null || printf '%s/Pictures' "$HOME")"
    mkdir -p "$pictures_dir/Wallpapers" "$pictures_dir/Screenshots" 2>/dev/null || true

    for src in "$dotfiles"/config/applications/*.desktop; do
        [[ -f "$src" ]] || continue
        install_file "$src" "$HOME/.local/share/applications/$(basename "$src")"
    done

    merge_chrome_flags

    for src in "$dotfiles"/assets/wallpapers/*; do
        [[ -f "$src" ]] || continue
        dest="$pictures_dir/Wallpapers/$(basename "$src")"
        if [[ -e "$dest" ]]; then
            log "wallpaper preserved: $dest"
        else
            install_file "$src" "$dest"
        fi
    done

    if [[ -f "$dotfiles/config/fastfetch/config.jsonc" ]]; then
        install_file "$dotfiles/config/fastfetch/config.jsonc" "$HOME/.config/fastfetch/config.jsonc"
    fi
    if [[ -f "$dotfiles/assets/images/tomoe-fastfetch.png" ]]; then
        install_file "$dotfiles/assets/images/tomoe-fastfetch.png" "$HOME/.config/fastfetch/tomoe-fastfetch.png"
    fi
}

copy_models() {
    local dest_btop="$HOME/.config/btop/btop.conf"
    local dest_gtk3="$HOME/.config/gtk-3.0/gtk.css"
    local dest_gtk4="$HOME/.config/gtk-4.0/gtk.css"
    local dest_kitty="$HOME/.config/kitty/kitty.conf"
    local dest_qt5="$HOME/.config/qt5ct/qt5ct.conf"
    local dest_qt6="$HOME/.config/qt6ct/qt6ct.conf"
    local dest_environment_dir="$HOME/.config/environment.d"

    [[ -f "$dotfiles/config/btop/btop.conf" ]] && install_file "$dotfiles/config/btop/btop.conf" "$dest_btop"
    [[ -f "$dotfiles/config/gtk-3.0/gtk.css" ]] && install_file "$dotfiles/config/gtk-3.0/gtk.css" "$dest_gtk3"
    [[ -f "$dotfiles/config/gtk-4.0/gtk.css" ]] && install_file "$dotfiles/config/gtk-4.0/gtk.css" "$dest_gtk4"
    [[ -f "$dotfiles/config/kitty/kitty.conf" ]] && install_file "$dotfiles/config/kitty/kitty.conf" "$dest_kitty"
    [[ -f "$dotfiles/config/qt5ct/qt5ct.conf" ]] && install_file "$dotfiles/config/qt5ct/qt5ct.conf" "$dest_qt5"
    [[ -f "$dotfiles/config/qt6ct/qt6ct.conf" ]] && install_file "$dotfiles/config/qt6ct/qt6ct.conf" "$dest_qt6"
    mkdir -p "$dest_environment_dir"
    local env_src
    for env_src in "$dotfiles"/config/environment.d/*.conf; do
        [[ -f "$env_src" ]] || continue
        install_file "$env_src" "$dest_environment_dir/$(basename "$env_src")"
    done

    if [[ "$dry_run" == false ]]; then
        if [[ -f "$dest_qt5" ]]; then
            sed -i "s#__HOME__#$HOME#g" "$dest_qt5" || warn "could not resolve HOME in $dest_qt5"
        fi
        if [[ -f "$dest_qt6" ]]; then
            sed -i "s#__HOME__#$HOME#g" "$dest_qt6" || warn "could not resolve HOME in $dest_qt6"
        fi
    fi
}

configure_hid_apple() {
    if [[ ! -d /sys/module/hid_apple ]]; then
        log "hid_apple not present; skipping Apple keyboard fix"
        return 0
    fi

    if [[ -w /sys/module/hid_apple/parameters/fnmode ]]; then
        if [[ "$dry_run" == true ]]; then
            log "[dry-run] set hid_apple fnmode -> 2"
        else
            echo 2 | sudo tee /sys/module/hid_apple/parameters/fnmode >/dev/null \
                || warn "could not set hid_apple fnmode"
        fi
    fi

    if [[ "$dry_run" == true ]]; then
        log "[dry-run] persist hid_apple fnmode=2 -> /etc/modprobe.d/hid_apple.conf"
        return 0
    fi

    echo 'options hid_apple fnmode=2' | sudo tee /etc/modprobe.d/hid_apple.conf >/dev/null \
        || warn "could not persist hid_apple fnmode"

    if command -v mkinitcpio >/dev/null 2>&1; then
        run_logged sudo mkinitcpio -P || warn "could not regenerate initramfs"
    fi
}

sed_escape() {
    printf '%s' "$1" | sed -e 's/[\\&/]/\\&/g'
}
detect_keyboard_layout() {
    local layout="" variant=""
    if command -v localectl >/dev/null 2>&1; then
        layout="$(localectl status 2>/dev/null | sed -n 's/.*X11 Layout:[[:space:]]*//p' | head -n 1 | tr -d '[:space:]')"
        variant="$(localectl status 2>/dev/null | sed -n 's/.*X11 Variant:[[:space:]]*//p' | head -n 1)"
    fi
    if [[ -z "$layout" && -r /etc/vconsole.conf ]]; then
        layout="$(sed -n 's/^XKBLAYOUT=//p' /etc/vconsole.conf | head -n 1 | tr -d '\"')"
        variant="$(sed -n 's/^XKBVARIANT=//p' /etc/vconsole.conf | head -n 1 | tr -d '\"')"
    fi
    if [[ -z "$layout" ]]; then
        layout="us"
    fi
    if [[ -z "$variant" || "$variant" == "-" || "$variant" == "none" ]]; then
        variant="intl"
    fi
    printf '%s %s' "$layout" "$variant"
}

configure_keyboard_layout() {
    local target="$1"
    [[ -f "$target" ]] || return 0
    local layout variant
    read -r layout variant <<<"$(detect_keyboard_layout)"
    if [[ "$dry_run" == true ]]; then
        log "[dry-run] keyboard layout: $layout / $variant -> $target"
        return 0
    fi
    sed -i -E "s/^[[:space:]]*layout[[:space:]]*=.*/layout = \"$layout\"/" -- "$target"
    sed -i -E "s/^[[:space:]]*variant[[:space:]]*=.*/variant = \"$variant\"/" -- "$target"
    log "keyboard layout configured: $layout / $variant"
}

encode_uri_path() {
    command -v jq >/dev/null 2>&1 || { printf '%s' "$1"; return 0; }
    jq -nr --arg p "$1" '($p | split("/") | map(@uri) | join("/"))'
}

write_nautilus_bookmarks() {
    if command -v xdg-user-dirs-update >/dev/null 2>&1; then
        xdg-user-dirs-update >/dev/null 2>&1 || true
    fi

    local pictures downloads documents music videos
    pictures="$(xdg-user-dir PICTURES 2>/dev/null || printf '%s/Pictures' "$HOME")"
    downloads="$(xdg-user-dir DOWNLOAD 2>/dev/null || printf '%s/Downloads' "$HOME")"
    documents="$(xdg-user-dir DOCUMENTS 2>/dev/null || printf '%s/Documents' "$HOME")"
    music="$(xdg-user-dir MUSIC 2>/dev/null || printf '%s/Music' "$HOME")"
    videos="$(xdg-user-dir VIDEOS 2>/dev/null || printf '%s/Videos' "$HOME")"

    local -a dirs=( "$downloads" "$documents" "$pictures" "$music" "$videos" )
    local dest="$HOME/.config/gtk-3.0/bookmarks"
    local dir uri label

    backup_path "$dest"

    if [[ "$dry_run" == true ]]; then
        log "[dry-run] write nautilus bookmarks -> $dest"
        printf '  %s(dry-run)%s nautilus bookmarks -> %s\n' "$C_DIM" "$C_RESET" "$dest"
        for dir in "${dirs[@]}"; do
            uri="file://$(encode_uri_path "$dir")"
            label="$(basename "$dir")"
            printf '  %s %s\n' "$uri" "$label"
        done
        return 0
    fi

    mkdir -p "$(dirname "$dest")"
    : >"$dest"
    for dir in "${dirs[@]}"; do
        uri="file://$(encode_uri_path "$dir")"
        label="$(basename "$dir")"
        printf '%s %s\n' "$uri" "$label" >>"$dest"
    done
    log "nautilus bookmarks written: $dest"
}

configure_theme() {
    if [[ "$dry_run" == true ]]; then
        log "[dry-run] systemctl --user daemon-reexec"
        log "[dry-run] systemctl --user set-environment XCURSOR_THEME=Bibata-Modern-Classic XCURSOR_SIZE=24"
    else
        run_logged systemctl --user daemon-reexec || warn "could not reexec systemd user manager"
        run_logged systemctl --user set-environment XCURSOR_THEME=Bibata-Modern-Classic XCURSOR_SIZE=24 || true
    fi

    if command -v gsettings >/dev/null 2>&1; then
        if [[ "$dry_run" == true ]]; then
            log "[dry-run] gsettings icon-theme -> Papirus-Dark"
            log "[dry-run] gsettings cursor-theme -> Bibata-Modern-Classic"
            log "[dry-run] gsettings cursor-size -> 24"
        else
            run_logged gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark' \
                || warn "could not set icon theme"
            run_logged gsettings set org.gnome.desktop.interface cursor-theme 'Bibata-Modern-Classic' \
                || warn "could not set cursor theme"
            run_logged gsettings set org.gnome.desktop.interface cursor-size 24 \
                || warn "could not set cursor size"
        fi
    fi

    if command -v papirus-folders >/dev/null 2>&1; then
        if [[ "$dry_run" == true ]]; then
            log "[dry-run] papirus-folders -t Papirus-Dark -C white"
        else
            run_logged sudo papirus-folders -t Papirus-Dark -C white \
                || warn "could not recolor Papirus folders"
        fi
    fi
}

configure_desktop_defaults() {
    configure_theme
    if command -v xdg-settings >/dev/null 2>&1; then
        run_logged xdg-settings set default-web-browser google-chrome.desktop \
            || warn "could not set default browser"
    fi
    if command -v gio >/dev/null 2>&1; then
        run_logged gio mime inode/directory org.gnome.Nautilus.desktop \
            || warn "could not set Nautilus as default file manager"
    fi
    write_nautilus_bookmarks
    configure_hid_apple
}

configure_noctalia() {
    local pictures_dir wallpaper_src wallpaper_dest avatar_src avatar_dest
    local noctalia_config noctalia_state sed_avatar
    pictures_dir="$(xdg-user-dir PICTURES 2>/dev/null || printf '%s/Pictures' "$HOME")"
    wallpaper_src="$dotfiles/assets/wallpapers/chie-satonaka-monochrome.png"
    if [[ ! -f "$wallpaper_src" ]]; then
        local first
        first="$(find "$dotfiles/assets/wallpapers" -maxdepth 1 -type f -print -quit 2>/dev/null || true)"
        [[ -n "$first" ]] && wallpaper_src="$first"
    fi
    [[ -f "$wallpaper_src" ]] || die "$msg_missing $wallpaper_src"

    wallpaper_dest="$pictures_dir/Wallpapers/$(basename "$wallpaper_src")"
    mkdir -p "$(dirname "$wallpaper_dest")" 2>/dev/null || true

    if [[ -e "$wallpaper_dest" ]]; then
        log "wallpaper preserved: $wallpaper_dest"
    else
        install_file "$wallpaper_src" "$wallpaper_dest"
    fi

    avatar_src="$dotfiles/assets/images/sources/chie-satonaka-chibi.png"
    if [[ -f "$avatar_src" ]]; then
        avatar_dest="$HOME/.local/share/tomoe/avatar.png"
        install_file "$avatar_src" "$avatar_dest" 644
    else
        avatar_dest=""
    fi

    noctalia_config="$HOME/.config/noctalia/settings.toml"
    noctalia_state="$HOME/.local/state/noctalia/settings.toml"
    backup_path "$noctalia_config"
    backup_path "$noctalia_state"

    if [[ "$dry_run" == true ]]; then
        log "[dry-run] install noctalia config -> $noctalia_config / $noctalia_state (wallpaper=$wallpaper_dest)"
        printf '  %s(dry-run)%s noctalia config -> %s\n' "$C_DIM" "$C_RESET" "$noctalia_state"
    else
        mkdir -p "$(dirname "$noctalia_config")" "$(dirname "$noctalia_state")"
        if [[ -n "$avatar_dest" ]]; then
            sed_avatar="$(sed_escape "$avatar_dest")"
        else
            sed_avatar=""
        fi
        sed -e "s#__WALLPAPER__#$(sed_escape "$wallpaper_dest")#g"             -e "s#__AVATAR__#$sed_avatar#g"             "$dotfiles/config/noctalia/settings.toml" >"$noctalia_state"             || die "$msg_install_failed $noctalia_state"
        cp -- "$noctalia_state" "$noctalia_config"
        log "installed: $noctalia_state"
    fi

    configure_desktop_defaults
}

configure_greetd() {
    if ! id -u greeter >/dev/null 2>&1; then
        run_logged sudo useradd --system --home-dir /var/lib/greetd --create-home \
            --shell /usr/bin/nologin greeter \
            || die "$msg_install_failed greeter user"
    fi
    if ! id -nG greeter 2>/dev/null | grep -qw video; then
        run_logged sudo usermod -aG video greeter \
            || warn "$msg_greeter_group_failed"
    fi
    backup_system_path /etc/greetd/config.toml
    run_logged sudo install -Dm644 "$dotfiles/config/greetd/config.toml" /etc/greetd/config.toml \
        || die "$msg_install_failed /etc/greetd/config.toml"
    run_logged sudo systemctl enable greetd \
        || warn "$msg_greetd_enable_failed"
}

validate_installed_config() {
    local target="$HOME/.config/umbriel/config.toml"
    if [[ "$dry_run" == true ]]; then
        target="$dotfiles/config/umbriel/config.toml"
    fi
    validate_config "$target"
    if command -v noctalia >/dev/null 2>&1; then
        local noctalia_target="$HOME/.config/noctalia/settings.toml"
        local noctalia_state_target="$HOME/.local/state/noctalia/settings.toml"
        if [[ "$dry_run" == true ]]; then
            noctalia_target="$dotfiles/config/noctalia/settings.toml"
            noctalia_state_target="$dotfiles/config/noctalia/settings.toml"
        fi
        if [[ -f "$noctalia_state_target" ]]; then
            if [[ "$dry_run" == true ]]; then
                noctalia config validate "$noctalia_state_target" || die "$msg_invalid_config"
            else
                run_logged noctalia config validate "$noctalia_state_target" || die "$msg_invalid_config"
            fi
        fi
        if [[ "$noctalia_target" != "$noctalia_state_target" && -f "$noctalia_target" ]]; then
            if [[ "$dry_run" == true ]]; then
                noctalia config validate "$noctalia_target" || die "$msg_invalid_config"
            else
                run_logged noctalia config validate "$noctalia_target" || die "$msg_invalid_config"
            fi
        fi
    fi
}

restart_greetd() {
    local service=""
    if [[ -n "${XDG_SESSION_ID:-}" ]]; then
        service="$(loginctl show-session "$XDG_SESSION_ID" -p Service 2>/dev/null | cut -d= -f2 || true)"
    fi
    if [[ "$service" == *greetd* ]]; then
        warn "$msg_greetd_deferred"
        return 0
    fi
    run_logged sudo systemctl restart greetd || warn "$msg_greetd_restart_failed"
}

finish() {
    if [[ "$dry_run" == true ]]; then
        printf '\n%s✓ %s%s\n' "$C_GREEN" "$msg_dry_done" "$C_RESET"
    else
        printf '\n%s✓ %s%s\n' "$C_GREEN" "$msg_done" "$C_RESET"
    fi
    if [[ -n "$log_file" && -f "$log_file" ]]; then
        printf '%s  %s %s%s\n' "$C_DIM" "$msg_log" "$log_file" "$C_RESET"
    fi
    if [[ -n "$backup_dir" && -d "$backup_dir" ]]; then
        printf '%s  %s %s%s\n' "$C_DIM" "$msg_backups" "$backup_dir" "$C_RESET"
    fi
}

ask_reboot() {
    if [[ "$dry_run" == true ]]; then
        printf '%s\n' "$msg_dry_reboot"
        return 0
    fi
    if [[ "$reboot_after" == true ]]; then
        printf '%s\n' "$msg_reboot_yes"
        run_logged sudo systemctl reboot
        return 0
    fi
    if [[ "$assume_yes" == true ]]; then
        printf '%s\n' "$msg_reboot_skip"
        return 0
    fi
    if [[ ! -t 0 ]]; then
        printf '%s\n' "$msg_reboot_skip"
        return 0
    fi
    local answer=""
    read -r -p "$msg_reboot" answer || answer=""
    case "$answer" in
        s|S|sim|SIM|Sim|y|Y|yes|YES|Yes)
            printf '%s\n' "$msg_reboot_yes"
            run_logged sudo systemctl reboot
            ;;
        *) printf '%s\n' "$msg_reboot_skip" ;;
    esac
}

# ---------------------------------------------------------------------------
# Main command
# ---------------------------------------------------------------------------
install_command() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true ;;
            --yes|-y) assume_yes=true ;;
            --reboot) reboot_after=true ;;
            -h|--help) usage; return 0 ;;
            *) usage >&2; exit 2 ;;
        esac
        shift
    done

    start_sudo

    setup_logging
    show_header
    printf '\n'

    if [[ "$dry_run" == false ]]; then
        ask_install
    else
        printf '%s\n' "$msg_dry_run"
    fi

    step_begin "$msg_step_preflight"
    preflight
    step_done

    step_begin "$msg_step_remove"
    remove_packages
    step_done

    step_begin "$msg_step_pacman"
    install_pacman_packages
    step_done

    step_begin "$msg_step_aur"
    install_aur_packages "$dotfiles/packages/aur.txt" || die "$msg_install_failed AUR"
    step_done

    step_begin "$msg_step_validate_repo"
    validate_repo_config
    step_done

    step_begin "$msg_step_umbriel"
    copy_umbriel
    configure_keyboard_layout "$HOME/.config/umbriel/input.toml"
    step_done

    step_begin "$msg_step_desktop"
    copy_desktop
    copy_models
    step_done

    step_begin "$msg_step_noctalia"
    configure_noctalia
    step_done

    step_begin "$msg_step_greetd"
    configure_greetd
    step_done

    step_begin "$msg_step_validate"
    validate_installed_config
    step_done

    step_begin "$msg_step_restart"
    deferred_refresh all >/dev/null 2>&1 || true
    step_done

    finish
    if [[ "$dry_run" == true ]]; then
        printf '\n%sDry run complete. Greetd was not restarted.%s\n' "$C_DIM" "$C_RESET"
    else
        printf '\n%sGreetd restarted automatically.%s\n' "$C_DIM" "$C_RESET"
    fi
}


deferred_refresh() {
    local module
    local need_noctalia=false
    local need_greetd=false
    for module in "$@"; do
        case "$module" in
            noctalia) need_noctalia=true ;;
            greetd) need_greetd=true ;;
            all) need_noctalia=true; need_greetd=true ;;
        esac
    done

    if [[ "$need_noctalia" == true ]] && command -v noctalia >/dev/null 2>&1; then
        run_quiet noctalia msg plugins enable noctalia/umbriel-companion || warn "noctalia: could not enable Umbriel Companion"
        run_quiet noctalia msg templates-apply || warn "noctalia: could not apply theme templates"
        run_quiet noctalia msg config-reload || warn "noctalia: could not reload config"
        # greeter-sync is executed in the background by Noctalia. Retry once after
        # a short delay if it reports that a previous sync is still running.
        if ! run_quiet noctalia msg greeter-sync; then
            sleep 2
            if ! run_quiet noctalia msg greeter-sync; then
                warn "noctalia: greeter sync still running or unavailable; it will finish in the background"
            fi
        fi
    fi
    if [[ "$need_greetd" == true ]]; then
        restart_greetd
    fi
}


hidden_apps_command() {
    local mode="hide"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --list) mode="list" ;;
            --show) mode="show" ;;
            --hide) mode="hide" ;;
            -h|--help)
                cat <<'USAGE'
Usage:
  ./tomoe hidden-apps [--list|--show|--hide]

  --list  List hidden apps and their state.
  --show  Show hidden apps again.
  --hide  Hide apps (default).
USAGE
                return 0
                ;;
            *) usage >&2; exit 2 ;;
        esac
        shift
    done

    local target_dir="$HOME/.local/share/applications"
    mkdir -p "$target_dir"
    local -a entries=(lstopo.desktop qv4l2.desktop qvidcap.desktop limine-snapper-restore.desktop)
    local entry src dest label

    desktop_name() {
        [[ -f "$1" ]] || return 0
        sed -n 's/^Name=//p' "$1" | head -n 1
    }

    if [[ "$mode" == "list" ]]; then
        printf 'Hidden apps:\n'
        for entry in "${entries[@]}"; do
            dest="$target_dir/$entry"
            if [[ ! -f "$dest" ]]; then
                printf '  [missing] %s\n' "$entry"
                continue
            fi
            label="$(desktop_name "$dest")"
            if grep -Fxq 'NoDisplay=true' -- "$dest"; then
                printf '  [hidden]  %s - %s\n' "$entry" "${label:-$entry}"
            else
                printf '  [visible] %s - %s\n' "$entry" "${label:-$entry}"
            fi
        done
        return 0
    fi

    for entry in "${entries[@]}"; do
        dest="$target_dir/$entry"
        src=""

        if [[ -f "$dotfiles/config/applications/$entry" ]]; then
            src="$dotfiles/config/applications/$entry"
        elif [[ -f "/usr/share/applications/$entry" ]]; then
            src="/usr/share/applications/$entry"
        else
            warn "$msg_missing $entry"
            continue
        fi

        if [[ ! -f "$dest" ]]; then
            install_file "$src" "$dest" 644
        fi

        label="$(desktop_name "$dest")"
        if [[ "$mode" == "hide" ]]; then
            if grep -Eq '^NoDisplay=' -- "$dest"; then
                sed -i 's/^NoDisplay=.*/NoDisplay=true/' -- "$dest"
            else
                printf 'NoDisplay=true\n' >> "$dest"
            fi
            printf '  hidden: %s - %s\n' "$entry" "${label:-$entry}"
        else
            if grep -Eq '^NoDisplay=' -- "$dest"; then
                sed -i '/^NoDisplay=/d' -- "$dest"
            fi
            printf '  shown: %s - %s\n' "$entry" "${label:-$entry}"
        fi
        log "hidden app updated: $dest ($mode)"
    done
    printf 'Done: %s\n' "$mode"
}


apply_update_modules() {
    local module
    for module in "$@"; do
        log "[tomoe update] applying: $module"
        case "$module" in
            umbriel)
                step_begin "Updating Umbriel"
                copy_umbriel
                configure_keyboard_layout "$HOME/.config/umbriel/input.toml"
                step_done
                ;;
            monitors)
                step_begin "Updating monitors"
                if [[ -f "$dotfiles/config/umbriel/outputs.toml" ]]; then
                    install_file "$dotfiles/config/umbriel/outputs.toml" "$HOME/.config/umbriel/outputs.toml"
                fi
                step_done
                ;;
            fastfetch)
                step_begin "Updating Fastfetch"
                if [[ -f "$dotfiles/config/fastfetch/config.jsonc" ]]; then
                    install_file "$dotfiles/config/fastfetch/config.jsonc" "$HOME/.config/fastfetch/config.jsonc"
                fi
                if [[ -f "$dotfiles/assets/images/tomoe-fastfetch.png" ]]; then
                    install_file "$dotfiles/assets/images/tomoe-fastfetch.png" "$HOME/.config/fastfetch/tomoe-fastfetch.png"
                fi
                step_done
                ;;
            chrome)
                step_begin "Updating Chrome"
                merge_chrome_flags
                step_done
                ;;
            noctalia)
                step_begin "Updating Noctalia"
                copy_models
                configure_noctalia
                step_done
                ;;
            greetd)
                step_begin "Updating greetd"
                configure_greetd
                step_done
                ;;
            *)
                warn "unknown module: $module"
                ;;
        esac
    done
}

update_command() {
    local -a requested=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true ;;
            --yes|-y) assume_yes=true ;;
            --umbriel) requested+=("umbriel") ;;
            --monitors) requested+=("monitors") ;;
            --fastfetch) requested+=("fastfetch") ;;
            --chrome) requested+=("chrome") ;;
            --noctalia) requested+=("noctalia") ;;
            --greetd) requested+=("greetd") ;;
            --all) requested+=("umbriel" "monitors" "fastfetch" "chrome" "noctalia" "greetd") ;;
            -h|--help)
                printf '%s\n' "Usage:"
                printf '%s\n' "  ./tomoe update --umbriel"
                printf '%s\n' "  ./tomoe update --noctalia"
                printf '%s\n' "  ./tomoe update --fastfetch"
                printf '%s\n' "  ./tomoe update --chrome"
                printf '%s\n' "  ./tomoe update --greetd"
                printf '%s\n' "  ./tomoe update --monitors"
                printf '%s\n' "  ./tomoe update --all"
                return 0
                ;;
            *) usage >&2; exit 2 ;;
        esac
        shift
    done

    if (( ${#requested[@]} == 0 )); then
        printf '%s\n' "Usage: ./tomoe update --umbriel|--noctalia|--fastfetch|--chrome|--greetd|--monitors|--all"
        return 0
    fi

    start_sudo

    setup_logging
    show_header
    printf '\n'

    TOTAL_STEPS=$((4 + ${#requested[@]}))
    STEP=0
    step_begin "Checking selected modules"
    preflight
    step_done

    apply_update_modules "${requested[@]}"

    step_begin "Validating selected modules"
    validate_installed_config
    step_done

    step_begin "Finishing selected modules"
    deferred_refresh "${requested[@]}"
    step_done

    # Contextual completion message; not "whole Tomoe updated".
    if (( ${#requested[@]} == 1 )); then
        case "${requested[0]}" in
            umbriel) printf '\n%sUmbriel update complete.%s\n' "$C_DIM" "$C_RESET" ;;
            noctalia) printf '\n%sNoctalia update complete.%s\n' "$C_DIM" "$C_RESET" ;;
            fastfetch) printf '\n%sFastfetch update complete.%s\n' "$C_DIM" "$C_RESET" ;;
            chrome) printf '\n%sChrome flags update complete.%s\n' "$C_DIM" "$C_RESET" ;;
            greetd) printf '\n%sgreetd update complete.%s\n' "$C_DIM" "$C_RESET" ;;
            monitors) printf '\n%sMonitors update complete.%s\n' "$C_DIM" "$C_RESET" ;;
        esac
    else
        printf '\n%sUpdate complete.%s\n' "$C_DIM" "$C_RESET"
    fi
}

command_name="${1:-}"
if [[ $# -gt 0 ]]; then
    shift
fi

case "$command_name" in
    install) install_command "$@" ;;
    update) update_command "$@" ;;
    hidden-apps) hidden_apps_command "$@" ;;
    -h|--help|help|'') usage ;;
    *) usage >&2; exit 2 ;;
esac
