dotfiles="$repo_root/dotfiles"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/tomoe"
backup_dir=""
log_file=""
dry_run=false
assume_yes=false
reboot_after=false
sudo_keepalive_pid=""

