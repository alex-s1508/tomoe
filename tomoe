# ---------------------------------------------------------------------------
# Utilidades
# ---------------------------------------------------------------------------
usage() {
    cat <<'USAGE'
Usage:
  ./tomoe install [--dry-run] [--yes] [--reboot]
  ./tomoe refresh [--dry-run] [--yes]

  --dry-run   Show every action without changing the system.
  --yes, -y   Skip the installation confirmation (useful for automation).
  --reboot    Reboot automatically when the installation finishes.

The package lists live in dotfiles/packages/:
  repo.txt      official repository packages
  aur.txt       AUR packages installed with yay
  remove.txt    CachyOS packages removed when safe
USAGE
}

log() {
    [[ -n "$log_file" ]] || return 0
    printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" >>"$log_file"
}

warn() {
    printf '\n%s  ! %s%s\n' "$C_YELLOW" "$*" "$C_RESET" >&2
    log "WARN: $*"
}

die() {
    printf '\n%s  ✗ %s%s\n' "$C_RED" "$*" "$C_RESET" >&2
    log "ERROR: $*"
    show_log_tail
    exit 1
}

show_log_tail() {
    if [[ -n "${log_file:-}" && -f "$log_file" ]]; then
        printf '%s%s%s\n' "$C_DIM" "$msg_log_tail" "$C_RESET" >&2
        tail -n 30 "$log_file" >&2 || true
    fi
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || die "$msg_missing_cmd $1"
}

setup_logging() {
    if [[ "$dry_run" == true ]]; then
        log_file="$(mktemp "${TMPDIR:-/tmp}/tomoe-dry-run.XXXXXX.log")"
        backup_dir=""
    else
        mkdir -p "$state_dir"
        log_file="$state_dir/install-$(date +%Y%m%d-%H%M%S).log"
        : >"$log_file"
        backup_dir="$state_dir/backups/$(date +%Y%m%d-%H%M%S)"
    fi
}

show_header() {
    local header="$dotfiles/assets/ascii/installer.txt"
    if [[ -r "$header" ]]; then
        grep -v '^#' "$header" || true
    else
        printf 'T O M O E 巴\n'
    fi
}

ask_install() {
    if [[ "$assume_yes" == true ]]; then
        return 0
    fi
    if [[ ! -t 0 ]]; then
        die "$msg_need_tty"
    fi
    local answer=""
    read -r -p "$msg_confirm" answer || answer=""
    case "$answer" in
        s|S|sim|SIM|Sim|y|Y|yes|YES|Yes) return 0 ;;
        *) printf '%s\n' "$msg_cancelled"; exit 0 ;;
    esac
}

start_sudo() {
    if [[ "$dry_run" == true ]]; then
        return 0
    fi
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
        die "$msg_run_as_user"
    fi
    printf '%s\n' "$msg_sudo"
    sudo -v || die "sudo: authentication failed"
    (
        while kill -0 "$$" 2>/dev/null; do
            sudo -n true 2>/dev/null || exit 0
            sleep 50
        done
    ) &
    sudo_keepalive_pid=$!
    log "sudo keepalive started (pid $sudo_keepalive_pid)"
}

stop_sudo() {
    if [[ -n "$sudo_keepalive_pid" ]]; then
        kill "$sudo_keepalive_pid" 2>/dev/null || true
        wait "$sudo_keepalive_pid" 2>/dev/null || true
        sudo_keepalive_pid=""
    fi
}

cleanup() {
    stop_sudo
}

trap cleanup EXIT

on_error() {
    local rc=$?
    printf '\n%s  ✗ %s %s (exit %s)%s\n' "$C_RED" "$msg_error_line" "$1" "$rc" "$C_RESET" >&2
    show_log_tail
    exit "$rc"
}
trap 'on_error $LINENO' ERR

draw_bar() {
    local mark="${1:-}"
    local pct=$((STEP * 100 / TOTAL_STEPS))
    local filled=$((STEP * BAR_WIDTH / TOTAL_STEPS))
    local empty=$((BAR_WIDTH - filled))
    local bar="" emptybar=""
    printf -v bar '%*s' "$filled" ''
    printf -v emptybar '%*s' "$empty" ''
    bar="${bar// /█}"
    emptybar="${emptybar// /░}"
    printf '\r\033[2K  %s[%s%s]%s %3d%% %s' "$C_DIM" "$bar" "$emptybar" "$C_RESET" "$pct" "$mark"
}

step_begin() {
    STEP=$((STEP + 1))
    printf '\n%s▸ [%d/%d]%s %s\n' "$C_ACCENT" "$STEP" "$TOTAL_STEPS" "$C_RESET" "$1"
    draw_bar
}

step_done() {
    draw_bar "✓"
    printf '\n'
}

run_logged() {
    if [[ "$dry_run" == true ]]; then
        log "[dry-run] $*"
        printf '\r\033[2K  %s(dry-run)%s %s\n' "$C_DIM" "$C_RESET" "$*"
        return 0
    fi
    log "\$ $*"
    "$@" >>"$log_file" 2>&1 &
    local pid=$!
    local spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
    local i=0 idx
    while kill -0 "$pid" 2>/dev/null; do
        idx=$((i % ${#spin}))
        draw_bar "${spin:idx:1}"
        i=$((i + 1))
        sleep 0.12
    done
    local rc=0
    if wait "$pid"; then
        rc=0
    else
        rc=$?
    fi
    if [[ "$rc" -ne 0 ]]; then
        draw_bar "✗"
        printf '\n%s  ✗ %s (exit %d); see %s%s\n' "$C_RED" "$*" "$rc" "$log_file" "$C_RESET" >&2
    fi
    return "$rc"
}

read_list() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    sed -e 's/#.*//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' "$file" | grep -v '^$' || true
}

backup_path() {
    local src="$1" rel dest
    [[ -e "$src" || -L "$src" ]] || return 0
    if [[ "$dry_run" == true ]]; then
        log "[dry-run] backup $src"
        return 0
    fi
    if [[ "$src" == "$HOME"/* ]]; then
        rel="home/${src#"$HOME"/}"
    else
        rel="root${src}"
    fi
    dest="$backup_dir/$rel"
    if [[ -e "$dest" || -L "$dest" ]]; then
        return 0
    fi
    mkdir -p "$(dirname "$dest")"
    cp -a -- "$src" "$dest" || die "$msg_backup_failed $src"
    log "backup: $src -> $dest"
}

backup_system_path() {
    local src="$1" dest="$backup_dir/system$1"
    [[ -e "$src" || -L "$src" ]] || return 0
    if [[ -e "$dest" || -L "$dest" ]]; then
        return 0
    fi
    if [[ "$dry_run" == true ]]; then
        log "[dry-run] backup $src -> $dest"
        return 0
    fi
    sudo mkdir -p "$(dirname "$dest")"
    sudo cp -a -- "$src" "$dest" || die "$msg_backup_failed $src"
    sudo chown -R "$(id -u):$(id -g)" "$backup_dir" 2>/dev/null || true
    log "backup: $src -> $dest"
}

install_file() {
    local src="$1" dest="$2" mode="${3:-644}"
    if [[ "$dry_run" == true ]]; then
        log "[dry-run] install $src -> $dest"
        printf '\r\033[2K  %s(dry-run)%s %s -> %s\n' "$C_DIM" "$C_RESET" "$src" "$dest"
        return 0
    fi
    backup_path "$dest"
    mkdir -p "$(dirname "$dest")"
    if [[ -L "$dest" ]]; then
        rm -f -- "$dest"
    fi
    install -Dm"$mode" -- "$src" "$dest" || die "$msg_install_failed $dest"
    log "installed: $dest"
}

# ---------------------------------------------------------------------------
# Etapas
# ---------------------------------------------------------------------------
validate_config() {
    local target="$1"
    if [[ "$dry_run" == true ]]; then
        umbriel config validate -c "$target" || die "$msg_invalid_config"
    else
        run_logged umbriel config validate -c "$target" || die "$msg_invalid_config"
    fi
}

preflight() {
    [[ -d "$dotfiles" ]] || die "$msg_missing $dotfiles"
    local required=(
        "$dotfiles/assets/ascii/installer.txt"
        "$dotfiles/config/umbriel/config.toml"
        "$dotfiles/config/greetd/config.toml"
        "$dotfiles/config/noctalia/settings.toml"
        "$dotfiles/packages/repo.txt"
        "$dotfiles/packages/aur.txt"
        "$dotfiles/packages/remove.txt"
    )
    local file
    for file in "${required[@]}"; do
        [[ -f "$file" ]] || die "$msg_missing $file"
    done
    require_cmd sudo
    require_cmd pacman
    require_cmd systemctl
    require_cmd loginctl
    require_cmd install
    if [[ "${EUID:-$(id -u)}" -eq 0 ]]; then
        die "$msg_run_as_user"
    fi
    if command -v umbriel >/dev/null 2>&1; then
        validate_config "$dotfiles/config/umbriel/config.toml"
    fi
}

array_contains() {
    local needle="$1"
    shift
    local item
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

remove_packages() {
    local -a list=() candidates=() next=()
    mapfile -t list < <(read_list "$dotfiles/packages/remove.txt")
    (( ${#list[@]} )) || return 0
    local pkg required_by dep
    for pkg in "${list[@]}"; do
        pacman -Qq "$pkg" >/dev/null 2>&1 && candidates+=("$pkg")
    done
    (( ${#candidates[@]} )) || return 0

    while true; do
        next=()
        for pkg in "${candidates[@]}"; do
            required_by="$(LC_ALL=C pacman -Qi "$pkg" 2>/dev/null | awk -F': ' '/^Required By/{print $2; exit}')"
            local safe=true
            if [[ -n "$required_by" && "$required_by" != "None" ]]; then
                for dep in $required_by; do
                    if ! array_contains "$dep" "${candidates[@]}"; then
                        safe=false
                        break
                    fi
                done
            fi
            if [[ "$safe" == true ]]; then
                next+=("$pkg")
            else
                warn "$(printf "$msg_keep_pkg" "$pkg" "$required_by")"
            fi
        done
        if (( ${#next[@]} == ${#candidates[@]} )); then
            break
        fi
        candidates=("${next[@]}")
        (( ${#candidates[@]} )) || return 0
    done

    run_logged sudo pacman -Rns --noconfirm "${candidates[@]}" \
        || warn "$msg_remove_failed"
}

install_pacman_packages() {
    local -a pkgs=()
    mapfile -t pkgs < <(read_list "$dotfiles/packages/repo.txt")
    local pkg
    if printf '%s\n' "${pkgs[@]}" | grep -Fxq -- yay \
        && ! pacman -Qq yay >/dev/null 2>&1; then
        run_logged sudo pacman -S --needed --noconfirm yay \
            || die "$msg_install_failed yay"
    fi
    for pkg in "${pkgs[@]}"; do
        if pacman -Qq "$pkg" >/dev/null 2>&1; then
            log "$pkg já instalado"
            continue
        fi
        run_logged sudo pacman -S --needed --noconfirm "$pkg" \
            || die "$msg_install_failed $pkg"
    done
}

install_aur_packages() {
    local list="$1"
    local -a pkgs=()
    mapfile -t pkgs < <(read_list "$list")
    (( ${#pkgs[@]} )) || return 0
    command -v yay >/dev/null 2>&1 || die "$msg_yay_missing"
    local pkg
    for pkg in "${pkgs[@]}"; do
        if pacman -Qq "$pkg" >/dev/null 2>&1; then
            log "$pkg já instalado"
            continue
        fi
        run_logged yay -S --needed --noconfirm "$pkg" || return 1
    done
}

validate_repo_config() {
    command -v umbriel >/dev/null 2>&1 || die "$msg_umbriel_missing"
    validate_config "$dotfiles/config/umbriel/config.toml"
}

copy_umbriel() {
    local dest="$HOME/.config/umbriel"
    backup_path "$dest"
    if [[ -r /usr/share/umbriel/config.toml ]]; then
        install_file /usr/share/umbriel/config.toml "$dest/config.reference.toml"
    else
        warn "$msg_reference_missing"
    fi
    local file
    for file in "$dotfiles"/config/umbriel/*.toml; do
        install_file "$file" "$dest/$(basename "$file")"
    done
}

merge_chrome_flags() {
    local src="$dotfiles/config/chrome/flags.conf"
    local dest="$HOME/.config/chrome-flags.conf"
    local -a wanted=() missing=()
    mapfile -t wanted < <(read_list "$src")
    (( ${#wanted[@]} )) || return 0

    if [[ ! -f "$dest" ]]; then
        install_file "$src" "$dest"
        return 0
    fi

    local flag
    for flag in "${wanted[@]}"; do
        grep -Fxq -- "$flag" "$dest" || missing+=("$flag")
    done
    if (( ${#missing[@]} == 0 )); then
        log "chrome flags already present: $dest"
        return 0
    fi

    if [[ "$dry_run" == true ]]; then
        log "[dry-run] merge chrome flags -> $dest: ${missing[*]}"
        printf '\r\033[2K  %s(dry-run)%s chrome flags -> %s\n' "$C_DIM" "$C_RESET" "$dest"
        return 0
    fi

    backup_path "$dest"
    if [[ -L "$dest" ]]; then
        rm -f -- "$dest"
    fi
    if [[ -s "$dest" && "$(tail -c 1 -- "$dest" | wc -l)" -eq 0 ]]; then
        printf '\n' >>"$dest"
    fi
    printf '%s\n' "${missing[@]}" >>"$dest"
    log "chrome flags merged: ${missing[*]}"
}

copy_desktop() {
    local src dest
    for src in "$dotfiles"/config/applications/*.desktop; do
        [[ -f "$src" ]] || continue
        install_file "$src" "$HOME/.local/share/applications/$(basename "$src")"
    done

    merge_chrome_flags

    for src in "$dotfiles"/assets/wallpapers/*; do
        [[ -f "$src" ]] || continue
        dest="$(xdg-user-dir PICTURES 2>/dev/null || printf '%s/Pictures' "$HOME")/Wallpapers/$(basename "$src")"
        if [[ -e "$dest" ]]; then
            log "wallpaper preserved: $dest"
        else
            install_file "$src" "$dest"
        fi
    done
}

sed_escape() {
    printf '%s' "$1" | sed -e 's/[\\&/]/\\&/g'
}

encode_uri_path() {
    command -v jq >/dev/null 2>&1 || { printf '%s' "$1"; return 0; }
    jq -nr --arg p "$1" '($p | split("/") | map(@uri) | join("/"))'
}

detect_keyboard_layout() {
    local layout="" variant=""
    if command -v localectl >/dev/null 2>&1; then
        layout="$(localectl status 2>/dev/null | sed -n 's/.*X11 Layout:[[:space:]]*//p' | head -n 1 | tr -d '[:space:]')"
        variant="$(localectl status 2>/dev/null | sed -n 's/.*X11 Variant:[[:space:]]*//p' | head -n 1)"
    fi
    if [[ -z "$layout" && -r /etc/vconsole.conf ]]; then
        layout="$(sed -n 's/^XKBLAYOUT=//p' /etc/vconsole.conf | head -n 1 | tr -d '\"')"
        variant="$(sed -n 's/^XKBVARIANT=//p' /etc/vconsole.conf | head -n 1 | tr -d '\"')"
    fi
    if [[ -z "$layout" ]]; then
        layout="us"
    fi
    if [[ -z "$variant" || "$variant" == "-" || "$variant" == "none" ]]; then
        variant="intl"
    fi
    printf '%s %s' "$layout" "$variant"
}

configure_keyboard_layout() {
    local target="$1"
    [[ -f "$target" ]] || return 0
    local layout variant
    read -r layout variant <<<"$(detect_keyboard_layout)"
    if [[ "$dry_run" == true ]]; then
        log "[dry-run] keyboard layout: $layout / $variant -> $target"
        return 0
    fi
    sed -i -E "s/^[[:space:]]*layout[[:space:]]*=.*/layout = \"$layout\"/" -- "$target"
    sed -i -E "s/^[[:space:]]*variant[[:space:]]*=.*/variant = \"$variant\"/" -- "$target"
    log "keyboard layout configured: $layout / $variant"
}

write_nautilus_bookmarks() {
    if command -v xdg-user-dirs-update >/dev/null 2>&1; then
        xdg-user-dirs-update >/dev/null 2>&1 || true
    fi

    local pictures downloads documents music videos
    pictures="$(xdg-user-dir PICTURES 2>/dev/null || printf '%s/Pictures' "$HOME")"
    downloads="$(xdg-user-dir DOWNLOAD 2>/dev/null || printf '%s/Downloads' "$HOME")"
    documents="$(xdg-user-dir DOCUMENTS 2>/dev/null || printf '%s/Documents' "$HOME")"
    music="$(xdg-user-dir MUSIC 2>/dev/null || printf '%s/Music' "$HOME")"
    videos="$(xdg-user-dir VIDEOS 2>/dev/null || printf '%s/Videos' "$HOME")"

    local -a dirs=( "$downloads" "$documents" "$pictures" "$music" "$videos" )
    local dest="$HOME/.config/gtk-3.0/bookmarks"
    local dir uri label

    backup_path "$dest"

    if [[ "$dry_run" == true ]]; then
        log "[dry-run] write nautilus bookmarks -> $dest"
        printf '\r\033[2K  %s(dry-run)%s nautilus bookmarks -> %s\n' "$C_DIM" "$C_RESET" "$dest"
        for dir in "${dirs[@]}"; do
            uri="file://$(encode_uri_path "$dir")"
            label="$(basename "$dir")"
            printf '  %s %s\n' "$uri" "$label"
        done
        return 0
    fi

    mkdir -p "$(dirname "$dest")"
    : >"$dest"
    for dir in "${dirs[@]}"; do
        uri="file://$(encode_uri_path "$dir")"
        label="$(basename "$dir")"
        printf '%s %s\n' "$uri" "$label" >>"$dest"
    done
    log "nautilus bookmarks written: $dest"
}

configure_desktop_defaults() {
    if command -v xdg-settings >/dev/null 2>&1; then
        run_logged xdg-settings set default-web-browser google-chrome.desktop \
            || warn "could not set default browser"
    fi
    if command -v gio >/dev/null 2>&1; then
        run_logged gio mime inode/directory org.gnome.Nautilus.desktop \
            || warn "could not set Nautilus as default file manager"
    fi
}

configure_noctalia() {
    local pictures_dir wallpaper_src wallpaper_dest
    pictures_dir="$(xdg-user-dir PICTURES 2>/dev/null || printf '%s/Pictures' "$HOME")"
    wallpaper_src="$dotfiles/assets/wallpapers/chie-satonaka-monochrome.png"
    if [[ ! -f "$wallpaper_src" ]]; then
        local first
        first="$(find "$dotfiles/assets/wallpapers" -maxdepth 1 -type f -print -quit 2>/dev/null || true)"
        [[ -n "$first" ]] && wallpaper_src="$first"
    fi
    [[ -f "$wallpaper_src" ]] || die "$msg_missing $wallpaper_src"

    wallpaper_dest="$pictures_dir/Wallpapers/$(basename "$wallpaper_src")"
    mkdir -p "$(dirname "$wallpaper_dest")" 2>/dev/null || true

    if [[ -e "$wallpaper_dest" ]]; then
        log "wallpaper preserved: $wallpaper_dest"
    else
        install_file "$wallpaper_src" "$wallpaper_dest"
    fi

    local noctalia_config="$HOME/.config/noctalia/settings.toml"
    backup_path "$noctalia_config"
    if [[ "$dry_run" == true ]]; then
        log "[dry-run] install noctalia config -> $noctalia_config (wallpaper=$wallpaper_dest)"
        printf '\r\033[2K  %s(dry-run)%s noctalia config -> %s\n' "$C_DIM" "$C_RESET" "$noctalia_config"
    else
        mkdir -p "$(dirname "$noctalia_config")"
        sed "s#__WALLPAPER__#$(sed_escape "$wallpaper_dest")#g" "$dotfiles/config/noctalia/settings.toml" >"$noctalia_config" \
            || die "$msg_install_failed $noctalia_config"
        log "installed: $noctalia_config"
    fi

    configure_desktop_defaults
    write_nautilus_bookmarks

    if command -v noctalia >/dev/null 2>&1; then
        run_logged noctalia msg config-set shell.polkit_agent true || warn "noctalia: could not enable polkit agent"
        run_logged noctalia msg color-scheme-set wallpaper m3-monochrome || warn "noctalia: could not set color scheme"
        run_logged noctalia msg theme-mode-set dark || warn "noctalia: could not set theme mode"
        run_logged noctalia msg wallpaper-set "$wallpaper_dest" || warn "noctalia: could not set wallpaper"
        run_logged noctalia msg greeter-sync || warn "noctalia: could not sync greeter"
        run_logged noctalia msg config-reload || warn "noctalia: could not reload config"
    fi
}

configure_greetd() {
    if ! id -u greeter >/dev/null 2>&1; then
        run_logged sudo useradd --system --home-dir /var/lib/greetd --create-home \
            --shell /usr/bin/nologin greeter \
            || die "$msg_install_failed greeter user"
    fi
    if ! id -nG greeter 2>/dev/null | grep -qw video; then
        run_logged sudo usermod -aG video greeter \
            || warn "$msg_greeter_group_failed"
    fi
    backup_system_path /etc/greetd/config.toml
    run_logged sudo install -Dm644 "$dotfiles/config/greetd/config.toml" /etc/greetd/config.toml \
        || die "$msg_install_failed /etc/greetd/config.toml"
    run_logged sudo systemctl enable greetd \
        || warn "$msg_greetd_enable_failed"
}

validate_installed_config() {
    local target="$HOME/.config/umbriel/config.toml"
    if [[ "$dry_run" == true ]]; then
        target="$dotfiles/config/umbriel/config.toml"
    fi
    validate_config "$target"
    if command -v noctalia >/dev/null 2>&1; then
        local noctalia_target="$HOME/.config/noctalia/settings.toml"
        if [[ "$dry_run" == true ]]; then
            noctalia_target="$dotfiles/config/noctalia/settings.toml"
        fi
        if [[ -f "$noctalia_target" ]]; then
            if [[ "$dry_run" == true ]]; then
                noctalia config validate "$noctalia_target" || die "$msg_invalid_config"
            else
                run_logged noctalia config validate "$noctalia_target" || die "$msg_invalid_config"
            fi
        fi
    fi
}

restart_greetd() {
    local service=""
    if [[ -n "${XDG_SESSION_ID:-}" ]]; then
        service="$(loginctl show-session "$XDG_SESSION_ID" -p Service 2>/dev/null | cut -d= -f2 || true)"
    fi
    if [[ "$service" == *greetd* ]]; then
        warn "$msg_greetd_deferred"
        return 0
    fi
    run_logged sudo systemctl restart greetd || warn "$msg_greetd_restart_failed"
}

finish() {
    if [[ "$dry_run" == true ]]; then
        printf '\n%s✓ %s%s\n' "$C_GREEN" "$msg_dry_done" "$C_RESET"
    else
        printf '\n%s✓ %s%s\n' "$C_GREEN" "$msg_done" "$C_RESET"
    fi
    if [[ -n "$log_file" && -f "$log_file" ]]; then
        printf '%s  %s %s%s\n' "$C_DIM" "$msg_log" "$log_file" "$C_RESET"
    fi
    if [[ -n "$backup_dir" && -d "$backup_dir" ]]; then
        printf '%s  %s %s%s\n' "$C_DIM" "$msg_backups" "$backup_dir" "$C_RESET"
    fi
}

ask_reboot() {
    if [[ "$dry_run" == true ]]; then
        printf '%s\n' "$msg_dry_reboot"
        return 0
    fi
    if [[ "$reboot_after" == true ]]; then
        printf '%s\n' "$msg_reboot_yes"
        run_logged sudo systemctl reboot
        return 0
    fi
    if [[ "$assume_yes" == true ]]; then
        printf '%s\n' "$msg_reboot_skip"
        return 0
    fi
    if [[ ! -t 0 ]]; then
        printf '%s\n' "$msg_reboot_skip"
        return 0
    fi
    local answer=""
    read -r -p "$msg_reboot" answer || answer=""
    case "$answer" in
        s|S|sim|SIM|Sim|y|Y|yes|YES|Yes)
            printf '%s\n' "$msg_reboot_yes"
            run_logged sudo systemctl reboot
            ;;
        *) printf '%s\n' "$msg_reboot_skip" ;;
    esac
}

# ---------------------------------------------------------------------------
# Comando principal
# ---------------------------------------------------------------------------
install_command() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true ;;
            --yes|-y) assume_yes=true ;;
            --reboot) reboot_after=true ;;
            -h|--help) usage; return 0 ;;
            *) usage >&2; exit 2 ;;
        esac
        shift
    done

    setup_logging
    show_header
    printf '\n'

    if [[ "$dry_run" == false ]]; then
        ask_install
    else
        printf '%s\n' "$msg_dry_run"
    fi

    start_sudo

    step_begin "$msg_step_preflight"
    preflight
    step_done

    step_begin "$msg_step_remove"
    remove_packages
    step_done

    step_begin "$msg_step_pacman"
    install_pacman_packages
    step_done

    step_begin "$msg_step_aur"
    install_aur_packages "$dotfiles/packages/aur.txt" || die "$msg_install_failed AUR"
    step_done

    step_begin "$msg_step_validate_repo"
    validate_repo_config
    step_done

    step_begin "$msg_step_umbriel"
    copy_umbriel
    configure_keyboard_layout "$HOME/.config/umbriel/input.toml"
    step_done

    step_begin "$msg_step_desktop"
    copy_desktop
    step_done

    step_begin "$msg_step_noctalia"
    configure_noctalia
    step_done

    step_begin "$msg_step_greetd"
    configure_greetd
    step_done

    step_begin "$msg_step_validate"
    validate_installed_config
    step_done

    step_begin "$msg_step_restart"
    restart_greetd
    step_done

    finish
    ask_reboot
}

ask_refresh() {
    if [[ "$assume_yes" == true ]]; then
        return 0
    fi
    if [[ ! -t 0 ]]; then
        die "$msg_need_tty"
    fi
    local answer=""
    read -r -p "$msg_refresh_confirm" answer || answer=""
    case "$answer" in
        s|S|sim|SIM|Sim|y|Y|yes|YES|Yes) return 0 ;;
        *) printf '%s\n' "$msg_cancelled"; exit 0 ;;
    esac
}

refresh_command() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true ;;
            --yes|-y) assume_yes=true ;;
            -h|--help) usage; return 0 ;;
            *) usage >&2; exit 2 ;;
        esac
        shift
    done

    TOTAL_STEPS=6
    STEP=0
    setup_logging
    show_header
    printf '\n'

    if [[ "$dry_run" == false ]]; then
        ask_refresh
    else
        printf '%s\n' "$msg_dry_run"
    fi

    start_sudo

    step_begin "$msg_step_refresh_validate"
    preflight
    if command -v noctalia >/dev/null 2>&1 && [[ -f "$dotfiles/config/noctalia/settings.toml" ]]; then
        noctalia config validate "$dotfiles/config/noctalia/settings.toml" || die "$msg_invalid_config"
    fi
    step_done

    step_begin "$msg_step_refresh_files"
    copy_umbriel
    configure_keyboard_layout "$HOME/.config/umbriel/input.toml"
    copy_desktop
    configure_noctalia
    step_done

    step_begin "$msg_step_refresh_greetd"
    configure_greetd
    step_done

    step_begin "$msg_step_validate"
    validate_installed_config
    step_done

    step_begin "$msg_step_restart"
    restart_greetd
    step_done

    finish
}

command_name="${1:-}"
if [[ $# -gt 0 ]]; then
    shift
fi

case "$command_name" in
    install) install_command "$@" ;;
    refresh) refresh_command "$@" ;;
    -h|--help|help|'') usage ;;
    *) usage >&2; exit 2 ;;
esac
