--- a/Frame.qml
+++ b/Frame.qml
@@ -231,6 +231,28 @@
 
         // True when this monitor's active workspace holds a fullscreen window;
         // the frame then unmaps its input and hides so the window is unobstructed.
-        readonly property bool monFullscreen: Wm.outputHasFullscreen(root.modelData ? root.modelData.name : "")
+        // Resolve fullscreen per output and active workspace. The globally
+        // focused toplevel changes when the pointer crosses monitors, while
+        // Super+D can set the provider's workspace fullscreen flag for a
+        // maximized window. Wayland toplevel state distinguishes the two.
+        readonly property bool monFullscreen: {
+            const name = root.modelData ? root.modelData.name : "";
+            const output = Wm.outputByName(name);
+            if (!output || !output.activeWorkspace)
+                return Wm.outputHasFullscreen(name);
+            const workspace = String(output.activeWorkspace);
+            const windows = Wm.windows || [];
+            let hasToplevelState = false;
+            for (let i = 0; i < windows.length; ++i) {
+                const win = windows[i];
+                if (String(win.output || "") !== String(name)
+                        || String(win.workspace || "") !== workspace || !win.toplevel)
+                    continue;
+                hasToplevelState = true;
+                if (win.toplevel.fullscreen === true)
+                    return true;
+            }
+            return hasToplevelState ? false : Wm.outputHasFullscreen(name);
+        }
 
         onMonFullscreenChanged: if (monFullscreen) frameMenus.closeAll()
