//
//  Tomoe Fastfetch (adapted LierB ARCH preset)

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/tomoe-fastfetch.png",
    "type": "kitty",
    "height": 11,
    "preserveAspectRatio": true,
    "padding": {
      "top": 2,
      "right": 6,
      "bottom": 0,
      "left": 1
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 10
    },
    "break",
    {
      "type": "os",
      "key": "\uf013 "
    },
    {
      "type": "kernel",
      "key": "\uf473 "
    },
    {
      "type": "packages",
      "key": "\ueb29 "
    },
    {
      "type": "shell",
      "key": "\uf120 "
    },
    {
      "type": "terminal",
      "key": "\uf489 "
    },
    {
      "type": "wm",
      "key": "\uf488 "
    },
    {
      "type": "uptime",
      "key": "\ue385 ",
      "format": "{2}h {3}m"
    },
    {
      "type": "media",
      "key": "\udb81\udf5a "
    },
    "break",
    {
      "type": "colors",
      "symbol": "diamond"
    },
    "break",
    "break"
  ]
}
